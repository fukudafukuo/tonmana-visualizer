{
  "manifest_version": 3,
  "name": "トンマナビジュアライザー",
  "version": "1.0.0",
  "description": "Webページのトーン&マナー（色・タイポグラフィ・スペーシング）を可視化するツール",
  "permissions": ["activeTab", "tabs", "scripting", "sidePanel"],
  "action": {
    "default_title": "トンマナビジュアライザー"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
